{
  "name": "@kuntay/swisseph-viz",
  "version": "0.3.0",
  "description": "Astrolojik görselleştirme bileşenleri - D3.js tabanlı natal harita, transit ve synastry grafikleri",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "@kuntay/swisseph": "^0.2.2 || ^0.3.0",
    "d3": "^7.8.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "astrology",
    "visualization",
    "natal-chart",
    "d3",
    "webassembly"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuntay/swisseph-wasm.git",
    "directory": "packages/viz"
  }
}
