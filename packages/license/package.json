{
  "name": "@kuntay/swisseph-license",
  "version": "0.3.0",
  "description": "Ticari lisanslama ve uyumluluk araçları - AGPL ve ticari lisans seçenekleri",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "keywords": [
    "license",
    "commercial",
    "agpl",
    "compliance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuntay/swisseph-wasm.git",
    "directory": "packages/license"
  }
}
