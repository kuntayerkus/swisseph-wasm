{
  "name": "@kuntay/swisseph-advanced",
  "version": "0.3.0",
  "description": "Vedik astroloji modülleri - Nakshatra, uyumluluk analizi ve isim önerileri",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
